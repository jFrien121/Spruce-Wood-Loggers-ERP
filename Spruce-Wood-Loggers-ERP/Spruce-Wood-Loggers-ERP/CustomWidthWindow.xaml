<Window x:Class="Spruce_Wood_Loggers_ERP.CustomWidthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spruce_Wood_Loggers_ERP"
		xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
		mc:Ignorable="d"
		WindowStartupLocation="CenterOwner"
        Title="CustomWidthWindow" Height="310" Width="500">
	
	<WindowChrome.WindowChrome>
		<WindowChrome
        CaptionHeight="0"
        ResizeBorderThickness="5"
        CornerRadius="0"
        GlassFrameThickness="0"/>
	</WindowChrome.WindowChrome>

	<Grid>

		<Button x:Name="PiecesWideClose_Button"
				HorizontalAlignment="Right" 
				Background="Transparent" 
				VerticalAlignment="Top" 
				Padding="0,0" 
				BorderBrush="Transparent" 
				Height="50" 
				Margin="0,5,5,0"
				Click="PiecesWideClose_Button_Click">
			<materialDesign:PackIcon Kind="Close" 
							 HorizontalAlignment="Right" 
							 Width="50" 
							 Height="50" 
							 Margin="0,0" 
							 Foreground="Gray"/>
		</Button>

		<StackPanel VerticalAlignment="Center">

		<TextBlock 
			Text="Pieces Wide" 
			HorizontalAlignment="Center" 
			Margin="0,0,0,25" 
			FontWeight="Bold" 
			FontSize="30"/>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<Button
				Margin="3px"
				materialDesign:ButtonAssist.CornerRadius="5"
				IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
				Style="{StaticResource MaterialDesignRaisedButton}"
				Padding="2px"
				Height="65px"
				Width="80px" Click="WidthButton_Click">
					<TextBlock
					Text="6"
					FontSize="25px"
					TextWrapping="Wrap"
					TextAlignment="Center"
					Foreground="White"/>
				</Button>
				<Button
				Margin="3px"
				materialDesign:ButtonAssist.CornerRadius="5"
				IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
				Style="{StaticResource MaterialDesignRaisedButton}"
				Padding="2px"
				Height="65px"
				Width="80px" Click="WidthButton_Click">
					<TextBlock
					Text="7"
					FontSize="25px"
					TextWrapping="Wrap"
					TextAlignment="Center"
					Foreground="White"/>
				</Button>
				<Button
				Margin="3px"
				materialDesign:ButtonAssist.CornerRadius="5"
				IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
				Style="{StaticResource MaterialDesignRaisedButton}"
				Padding="2px"
				Height="65px"
				Width="80px" Click="WidthButton_Click">
					<TextBlock
					Text="8"
					FontSize="25px"
					TextWrapping="Wrap"
					TextAlignment="Center"
					Foreground="White"/>
				</Button>
				<Button
				Margin="3px"
				materialDesign:ButtonAssist.CornerRadius="5"
				IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
				Style="{StaticResource MaterialDesignRaisedButton}"
				Padding="2px"
				Height="65px"
				Width="80px" Click="WidthButton_Click">
					<TextBlock
					Text="9"
					FontSize="25px"
					TextWrapping="Wrap"
					TextAlignment="Center"
					Foreground="White"/>
				</Button>
				<Button
				Margin="3px"
				materialDesign:ButtonAssist.CornerRadius="5"
				IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
				Style="{StaticResource MaterialDesignRaisedButton}"
				Padding="2px"
				Height="65px"
				Width="80px" Click="WidthButton_Click">
					<TextBlock
					Text="10"
					FontSize="25px"
					TextWrapping="Wrap"
					TextAlignment="Center"
					Foreground="White"/>
				</Button>
			</StackPanel>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
				<Button
					Margin="3px"
					materialDesign:ButtonAssist.CornerRadius="5"
					IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
					Style="{StaticResource MaterialDesignRaisedButton}"
					Padding="2px"
					Height="65px"
					Width="80px" Click="WidthButton_Click">
					<TextBlock
						Text="11"
						FontSize="25px"
						TextWrapping="Wrap"
						TextAlignment="Center"
						Foreground="White"/>
						</Button>
				<Button
					Margin="3px"
					materialDesign:ButtonAssist.CornerRadius="5"
					IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
					Style="{StaticResource MaterialDesignRaisedButton}"
					Padding="2px"
					Height="65px"
					Width="80px" Click="WidthButton_Click">
					<TextBlock
						Text="12"
						FontSize="25px"
						TextWrapping="Wrap"
						TextAlignment="Center"
						Foreground="White"/>
				</Button>
				<Button
					Margin="3px"
					materialDesign:ButtonAssist.CornerRadius="5"
					IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
					Style="{StaticResource MaterialDesignRaisedButton}"
					Padding="2px"
					Height="65px"
					Width="80px" Click="WidthButton_Click">
					<TextBlock
						Text="13"
						FontSize="25px"
						TextWrapping="Wrap"
						TextAlignment="Center"
						Foreground="White"/>
				</Button>
				<Button
					Margin="3px"
					materialDesign:ButtonAssist.CornerRadius="5"
					IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
					Style="{StaticResource MaterialDesignRaisedButton}"
					Padding="2px"
					Height="65px"
					Width="80px" Click="WidthButton_Click">
					<TextBlock
						Text="14"
						FontSize="25px"
						TextWrapping="Wrap"
						TextAlignment="Center"
						Foreground="White"/>
				</Button>
				<Button
					Margin="3px"
					materialDesign:ButtonAssist.CornerRadius="5"
					IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
					Style="{StaticResource MaterialDesignRaisedButton}"
					Padding="2px"
					Height="65px"
					Width="80px" Click="WidthButton_Click">
					<TextBlock
						Text="15"
						FontSize="25px"
						TextWrapping="Wrap"
						TextAlignment="Center"
						Foreground="White"/>
				</Button>
			</StackPanel>
		</StackPanel>

	</Grid>
</Window>
